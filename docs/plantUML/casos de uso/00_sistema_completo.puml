@startuml Sistema RH Nexus - Vista General
!theme plain
title Sistema RH Nexus - Vista General de Módulos

left to right direction

' Actores principales
actor "Administrador" as Admin
actor "RH" as RH
actor "Gerente" as Gerente
actor "Jefe de Área" as JefeArea
actor "Candidato" as Candidato
actor "Sistema IA" as IA

' Módulos del sistema
package "🏢 Gestión Organizacional" {
    usecase "Gestionar Sedes" as UC1
    usecase "Gestionar Departamentos" as UC2
    usecase "Configurar Estructura" as UC3
}

package "👥 Gestión de Usuarios" {
    usecase "Registrar Usuarios" as UC4
    usecase "Gestionar Roles" as UC5
    usecase "Control de Acceso" as UC6
}

package "📝 Solicitudes de Personal" {
    usecase "Crear Solicitudes" as UC7
    usecase "Definir Requisitos" as UC8
    usecase "Configurar Etapas" as UC9
}

package "✅ Aprobación de Solicitudes" {
    usecase "Revisar Solicitudes" as UC10
    usecase "Aprobar/Rechazar" as UC11
    usecase "Asignar Responsables" as UC12
}

package "🤖 Reclutamiento Inteligente" {
    usecase "Registrar Candidatos" as UC13
    usecase "Evaluación Automática" as UC14
    usecase "Ranking de Candidatos" as UC15
}

package "📊 Evaluación de Candidatos" {
    usecase "Entrevistas" as UC16
    usecase "Pruebas Técnicas" as UC17
    usecase "Evaluación de Personalidad" as UC18
}

package "🎯 Selección y Contratación" {
    usecase "Seleccionar Candidato" as UC19
    usecase "Generar Oferta" as UC20
    usecase "Proceso de Contratación" as UC21
}

package "📈 Reportes y Analytics" {
    usecase "Reportes de Solicitudes" as UC22
    usecase "Analytics de Proceso" as UC23
    usecase "Dashboard Ejecutivo" as UC24
}

package "🔔 Notificaciones" {
    usecase "Notificaciones Automáticas" as UC25
    usecase "Configurar Preferencias" as UC26
    usecase "Gestión de Alertas" as UC27
}

package "⚙️ Configuración del Sistema" {
    usecase "Configurar Parámetros" as UC28
    usecase "Gestionar Permisos" as UC29
    usecase "Configurar Integraciones" as UC30
}

